# ============================================================
# Modèle de fichier .env — copie ce fichier en .env puis remplis
# tes clés. Laisse vide pour désactiver le fournisseur.
# ============================================================

GROQ_API_KEY=
OPENROUTER_API_KEY=

# ============================================================
# PISTE / Légifrance (API DILA) — vérification des références
# ============================================================
# Identifiants OAuth2 de ton application créée sur https://piste.gouv.fr
# (menu APPLICATIONS -> ton application -> onglet Authentication).
# PISTE_ENV : prod | sandbox
PISTE_ENV=prod
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
PISTE_API_KEY=
PISTE_API_SECRET=
# Ancienne variable (jeton simple) — laissée pour compatibilité.
LEGIFRANCE_API_TOKEN=
